#!/usr/bin/env bash
# Run the Nix-driven integration tests against the workspace-local
# schema-stack checkouts (record 1006 forcing function).
#
# This script:
#   1. Builds the spirit default package via Nix using
#      `path:` overrides for the schema-stack inputs, the same way
#      `scripts/check-local-schema-stack` does.
#   2. Exports `SPIRIT_NIX_BUILD_RESULT` so the cargo tests in
#      `tests/nix_integration.rs` reuse the Nix-built binaries
#      instead of invoking `nix build` themselves.
#   3. Runs `cargo test --test nix_integration -- --ignored`.
#
# Why a script instead of letting tests call `nix build` directly:
# the cycle's `tests/nix_integration.rs` accepts either path, but the
# script-driven flow caches the Nix build across the test suite,
# which matters for the multi-test wall-clock cost. The flake app
# `nix run .#nix-integration-tests` uses this same shape.
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

override_args=()
export_args=()

add_override() {
  local input="$1"
  local env_key="$2"
  local default_path="$3"
  local explicit_path="${!env_key:-}"
  local path="${explicit_path:-$default_path}"

  if [[ -n "$explicit_path" && ! -d "$path" ]]; then
    printf 'explicit %s path does not exist: %s\n' "$env_key" "$path" >&2
    exit 2
  fi

  if [[ -d "$path" ]]; then
    override_args+=(--override-input "$input" "path:$path")
    export_args+=("$env_key=$path")
  fi
}

add_override nota-next-source NOTA_NEXT_PATH /git/github.com/LiGoldragon/nota-next
add_override nota-codec-source NOTA_CODEC_PATH /git/github.com/LiGoldragon/nota-codec
add_override nota-derive-source NOTA_DERIVE_PATH /git/github.com/LiGoldragon/nota-derive
add_override schema-source SCHEMA_PATH /git/github.com/LiGoldragon/schema
add_override schema-next-source SCHEMA_NEXT_PATH /git/github.com/LiGoldragon/schema-next
add_override schema-rust-next-source SCHEMA_RUST_NEXT_PATH /git/github.com/LiGoldragon/schema-rust-next
add_override sema-source SEMA_PATH /git/github.com/LiGoldragon/sema
add_override sema-engine-source SEMA_ENGINE_PATH /git/github.com/LiGoldragon/sema-engine
add_override signal-core-source SIGNAL_CORE_PATH /git/github.com/LiGoldragon/signal-core
add_override signal-frame-source SIGNAL_FRAME_PATH /git/github.com/LiGoldragon/signal-frame
add_override signal-sema-source SIGNAL_SEMA_PATH /git/github.com/LiGoldragon/signal-sema
add_override triad-runtime-source TRIAD_RUNTIME_PATH /git/github.com/LiGoldragon/triad-runtime

build_result="$(nix build \
  "${override_args[@]}" \
  --log-format bar-with-logs \
  --print-out-paths \
  --no-link \
  "$repo_root#default")"

if [[ -z "$build_result" ]]; then
  printf 'nix build produced no out path\n' >&2
  exit 3
fi

printf 'using Nix-built binaries at %s\n' "$build_result"
export SPIRIT_NIX_BUILD_RESULT="$build_result"
for assignment in "${export_args[@]}"; do
  export "$assignment"
done

cd "$repo_root"
exec cargo test --features nota-text --test nix_integration -- --ignored "$@"
