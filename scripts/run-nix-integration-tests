#!/usr/bin/env bash
# Run the Nix-driven integration tests against pushed schema-stack refs
# (record 1006 forcing function).
#
# This script:
#   1. Builds the spirit default package via Nix using remote
#      `github:` overrides for the schema-stack inputs, the same way
#      `scripts/check-local-schema-stack` does.
#   2. Exports `SPIRIT_NIX_BUILD_RESULT` so the cargo tests in
#      `tests/nix_integration.rs` reuse the Nix-built binaries
#      instead of invoking `nix build` themselves.
#   3. Runs `cargo test --test nix_integration -- --ignored`.
#
# Why a script instead of letting tests call `nix build` directly:
# the cycle's `tests/nix_integration.rs` accepts either path, but the
# script-driven flow caches the Nix build across the test suite,
# which matters for the multi-test wall-clock cost. The flake app
# `nix run .#nix-integration-tests` uses this same shape.
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
stack_reference="${SPIRIT_STACK_REF:-main}"
target_reference="${SPIRIT_TARGET_REF:-$stack_reference}"
github_owner=LiGoldragon

override_args=()
export_args=()

add_override() {
  local input="$1"
  local repository="$2"
  local environment_key="$3"
  local explicit_reference="${!environment_key:-}"
  local reference="${explicit_reference:-$stack_reference}"

  override_args+=(--override-input "$input" "github:$github_owner/$repository?ref=$reference")
  export_args+=("$environment_key=$reference")
}

add_override nota-next-source nota-next NOTA_NEXT_REF
add_override schema-next-source schema-next SCHEMA_NEXT_REF
add_override schema-rust-next-source schema-rust-next SCHEMA_RUST_NEXT_REF
add_override sema-source sema SEMA_REF
add_override sema-engine-source sema-engine SEMA_ENGINE_REF
add_override signal-frame-source signal-frame SIGNAL_FRAME_REF
add_override signal-sema-source signal-sema SIGNAL_SEMA_REF
add_override signal-spirit-source signal-spirit SIGNAL_SPIRIT_REF
add_override meta-signal-spirit-source meta-signal-spirit META_SIGNAL_SPIRIT_REF
add_override triad-runtime-source triad-runtime TRIAD_RUNTIME_REF

build_result="$(nix build \
  --refresh \
  "${override_args[@]}" \
  --log-format bar-with-logs \
  --print-out-paths \
  --no-link \
  "github:$github_owner/spirit?ref=$target_reference#default")"

if [[ -z "$build_result" ]]; then
  printf 'nix build produced no out path\n' >&2
  exit 3
fi

printf 'using Nix-built binaries at %s\n' "$build_result"
export SPIRIT_NIX_BUILD_RESULT="$build_result"
export SPIRIT_STACK_REF="$stack_reference"
export SPIRIT_TARGET_REF="$target_reference"
for assignment in "${export_args[@]}"; do
  export "$assignment"
done

cd "$repo_root"
exec cargo test --features nota-text --test nix_integration -- --ignored "$@"
