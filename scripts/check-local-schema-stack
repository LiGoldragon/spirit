#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
stack_reference="${SPIRIT_STACK_REF:-}"
target_reference="${SPIRIT_TARGET_REF:-$(git -C "$repo_root" rev-parse HEAD)}"
github_owner=LiGoldragon

args=(nix flake check "github:$github_owner/spirit?ref=$target_reference")

add_override() {
  local input="$1"
  local repository="$2"
  local environment_key="$3"
  local explicit_reference="${!environment_key:-}"
  local reference="${explicit_reference:-$stack_reference}"

  if [[ -z "$reference" ]]; then
    return
  fi

  args+=(--override-input "$input" "github:$github_owner/$repository?ref=$reference")
}

# Historical entry-point name retained; this check uses pushed refs only.
add_override nota-source nota NOTA_REF
add_override schema-source schema SCHEMA_REF
add_override schema-rust-source schema-rust SCHEMA_RUST_REF
add_override sema-source sema SEMA_REF
add_override sema-engine-source sema-engine SEMA_ENGINE_REF
add_override signal-frame-source signal-frame SIGNAL_FRAME_REF
add_override signal-sema-source signal-sema SIGNAL_SEMA_REF
add_override triad-runtime-source triad-runtime TRIAD_RUNTIME_REF

exec "${args[@]}" "$@"
