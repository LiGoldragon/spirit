{
  Entry signal-spirit:signal:Entry
  Query signal-spirit:signal:Query
  RecordIdentifier signal-spirit:signal:RecordIdentifier
  DomainScopes signal-domain:domain:DomainScopes
  SearchText signal-spirit:signal:SearchText
  ImportanceBump signal-spirit:signal:ImportanceBump
  RecordChange signal-spirit:signal:RecordChange
  SemaReceipt signal-spirit:signal:SemaReceipt
  ImportanceBumpReceipt signal-spirit:signal:ImportanceBumpReceipt
  RecordChangeReceipt signal-spirit:signal:RecordChangeReceipt
  ObservedRecords signal-spirit:signal:ObservedRecords
  FoundRecord signal-spirit:signal:FoundRecord
  CountedRecords signal-spirit:signal:CountedRecords
  ErrorReport signal-spirit:signal:ErrorReport
}
[WriteInput ReadInput]
[WriteOutput ReadOutput]
{
  WriteInput [(Record) (BumpImportance) (ChangeRecord)]
  Record Entry
  BumpImportance ImportanceBump
  ChangeRecord RecordChange

  ReadInput [(Observe) (Intent) (TextSearch) (Lookup) (Count)]
  Observe Query
  Intent DomainScopes
  TextSearch SearchText
  Lookup RecordIdentifier
  Count Query

  WriteOutput [(Recorded) (ImportanceBumped) (RecordChanged) (Missed)]
  Recorded SemaReceipt
  ImportanceBumped ImportanceBumpReceipt
  RecordChanged RecordChangeReceipt
  Missed ErrorReport

  ReadOutput [(Observed) (IntentResults) (TextSearchResults) (Found) (Counted) (Missed)]
  Observed ObservedRecords
  IntentResults ObservedRecords
  TextSearchResults ObservedRecords
  Found FoundRecord
  Counted CountedRecords

  StoredRecord { RecordIdentifier Entry }
  SourceSchemaVersion Integer
  MigratedRecordCount Integer
  Migration { SourceSchemaVersion MigratedRecordCount }
  RecordsFamily (Family { record.StoredRecord table.records key.Domain })
  MigrationsFamily (Family { record.Migration table.migrations key.Domain })
}
