{
  Entry signal-spirit:signal:Entry
  Query signal-spirit:signal:Query
  RecordIdentifier signal-spirit:signal:RecordIdentifier
  Referent signal-spirit:signal:Referent
  Referents signal-spirit:signal:Referents
  Removal signal-spirit:signal:Removal
  CertaintyChange signal-spirit:signal:CertaintyChange
  ImportanceBump signal-spirit:signal:ImportanceBump
  RecordChange signal-spirit:signal:RecordChange
  ReferentRegistration signal-spirit:signal:ReferentRegistration
  SemaReceipt signal-spirit:signal:SemaReceipt
  RemoveReceipt signal-spirit:signal:RemoveReceipt
  CertaintyChangeReceipt signal-spirit:signal:CertaintyChangeReceipt
  ImportanceBumpReceipt signal-spirit:signal:ImportanceBumpReceipt
  RecordChangeReceipt signal-spirit:signal:RecordChangeReceipt
  ReferentRegistrationReceipt signal-spirit:signal:ReferentRegistrationReceipt
  ObservedRecords signal-spirit:signal:ObservedRecords
  FoundRecord signal-spirit:signal:FoundRecord
  CountedRecords signal-spirit:signal:CountedRecords
  ErrorReport signal-spirit:signal:ErrorReport
}
[WriteInput ReadInput]
[WriteOutput ReadOutput]
{
  WriteInput [(Record) (Remove) (ChangeCertainty) (BumpImportance) (ChangeRecord) (RegisterReferent)]
  Record Entry
  Remove Removal
  ChangeCertainty CertaintyChange
  BumpImportance ImportanceBump
  ChangeRecord RecordChange
  RegisterReferent ReferentRegistration

  ReadInput [(Observe) (Lookup) (Count)]
  Observe Query
  Lookup RecordIdentifier
  Count Query

  WriteOutput [(Recorded) (Removed) (CertaintyChanged) (ImportanceBumped) (RecordChanged) (ReferentRegistered) (Missed)]
  Recorded SemaReceipt
  Removed RemoveReceipt
  CertaintyChanged CertaintyChangeReceipt
  ImportanceBumped ImportanceBumpReceipt
  RecordChanged RecordChangeReceipt
  ReferentRegistered ReferentRegistrationReceipt
  Missed ErrorReport

  ReadOutput [(Observed) (Found) (Counted) (Missed)]
  Observed ObservedRecords
  Found FoundRecord
  Counted CountedRecords

  StoredRecord { RecordIdentifier Entry }
  StoredReferent { Referent aliases.Referents }
  SourceSchemaVersion Integer
  MigratedRecordCount Integer
  MigratedReferentCount Integer
  Migration { SourceSchemaVersion MigratedRecordCount MigratedReferentCount }
  RecordsFamily (Family { record StoredRecord table records key Domain })
  ReferentsFamily (Family { record StoredReferent table referents key Domain })
  MigrationsFamily (Family { record Migration table migrations key Domain })
}
