{}
((Record Entry) (Observe Query) (Remove RecordIdentifier))
((RecordAccepted SemaReceipt) (RecordsObserved ObservedRecords) (RecordRemoved RemoveReceipt) (Error ErrorReport) (Rejected SignalRejection))
{
  SourcePath SourcePath@{ string@String }
  LocalPath LocalPath@{ string@String }
  PublicPath PublicPath@{ string@String }
  Import Import@{ sourcePath@SourcePath localPath@LocalPath }
  Export Export@{ localPath@LocalPath publicPath@PublicPath }
  SignalReuse SignalReuse@{ import@Import export@Export }
  NexusReuse NexusReuse@{ import@Import export@Export }
  SemaReuse SemaReuse@{ import@Import export@Export }
  NexusInput NexusInput@(Signal@Input Sema@SemaOutput)
  NexusOutput NexusOutput@(Sema@SemaInput Signal@Output)
  SemaInput SemaInput@(Record@Entry Observe@Query Remove@RecordIdentifier)
  SemaOutput SemaOutput@(Recorded@SemaReceipt Observed@ObservedRecords Removed@RemoveReceipt Missed@ErrorReport)
  Topic Topic@{ string@String }
  Topics Topics@{ values@(Vec Topic) }
  Description Description@{ string@String }
  ErrorMessage ErrorMessage@{ string@String }
  RecordIdentifier RecordIdentifier@{ integer@Integer }
  CommitSequence CommitSequence@{ integer@Integer }
  StateDigest StateDigest@{ integer@Integer }
  DatabaseMarker DatabaseMarker@{ commitSequence@CommitSequence stateDigest@StateDigest }
  SemaReceipt SemaReceipt@{ recordIdentifier@RecordIdentifier databaseMarker@DatabaseMarker }
  RemoveReceipt RemoveReceipt@{ recordIdentifier@RecordIdentifier databaseMarker@DatabaseMarker }
  ObservedRecords ObservedRecords@{ recordSet@RecordSet databaseMarker@DatabaseMarker }
  ErrorReport ErrorReport@{ errorMessage@ErrorMessage databaseMarker@DatabaseMarker }
  SignalRejection SignalRejection@{ validationError@ValidationError databaseMarker@DatabaseMarker }
  ValidationError ValidationError@(EmptyTopic EmptyDescription EmptyQueryTopic)
  MailIdentifier MailIdentifier@{ integer@Integer }
  ShortHeader ShortHeader@{ integer@Integer }
  SentMail SentMail@{ mailIdentifier@MailIdentifier originRoute@OriginRoute shortHeader@ShortHeader }
  ProcessedMail ProcessedMail@{ mailIdentifier@MailIdentifier originRoute@OriginRoute databaseMarker@DatabaseMarker }
  MailLedgerEvent MailLedgerEvent@(Sent@SentMail Processed@ProcessedMail)
  TopicMatch TopicMatch@(Partial@Topics Full@Topics)
  Entry Entry@{ topics@Topics kind@Kind description@Description magnitude@Magnitude }
  Query Query@{ topicMatch@TopicMatch kind@(Optional Kind) }
  RecordSet RecordSet@{ entries@(Vec Entry) }
  Kind Kind@(Decision Principle Correction Clarification Constraint)
  Magnitude Magnitude@(Minimum VeryLow Low Medium High VeryHigh Maximum)
}
