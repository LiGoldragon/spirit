{
  SignalInput spirit:signal:Input
  SignalOutput spirit:signal:Output
  SemaReadInput spirit:sema:ReadInput
  SemaReadOutput spirit:sema:ReadOutput
  SemaWriteOutput spirit:sema:WriteOutput
  Records spirit:signal:Records
  RecordCount spirit:signal:RecordCount
  StashHandle spirit:signal:StashHandle
  DatabaseMarker spirit:signal:DatabaseMarker
  Statement spirit:signal:Statement
  Entry spirit:signal:Entry
  Clarification spirit:signal:Clarification
  Supersession spirit:signal:Supersession
  Retirement spirit:signal:Retirement
  SemaReceipt spirit:signal:SemaReceipt
  ClarificationReceipt spirit:signal:ClarificationReceipt
  SupersessionReceipt spirit:signal:SupersessionReceipt
  RetirementReceipt spirit:signal:RetirementReceipt
  GuardianRejection spirit:signal:GuardianRejection
  GuardianRejectionReason spirit:signal:GuardianRejectionReason
  Explanation spirit:signal:Explanation
  ErrorReport spirit:signal:ErrorReport
  Query spirit:signal:Query
  SubscriptionToken spirit:signal:SubscriptionToken
  IntentSubscription spirit:signal:IntentSubscription
  RecordIdentifier spirit:signal:RecordIdentifier
  CertaintyChange spirit:signal:CertaintyChange
  WeightBump spirit:signal:WeightBump
  RecordChange spirit:signal:RecordChange
  RemovalCandidateCollection spirit:signal:RemovalCandidateCollection
  RemovalCandidatesCollection spirit:signal:RemovalCandidatesCollection
  ObserverFilter spirit:signal:ObserverFilter
  ObserverSubscription spirit:signal:ObserverSubscription
  ObserverRetraction spirit:signal:ObserverRetraction
}
[SignalArrived SemaWriteCompleted SemaReadCompleted EffectCompleted]
[CommandSemaWrite CommandSemaRead ReplyToSignal CommandEffect Continue]
{
  SignalArrived SignalInput
  SemaWriteCompleted SemaWriteOutput
  SemaReadCompleted SemaReadOutput
  EffectCompleted NexusEffectResult

  CommandSemaWrite [(Record) (Remove) (ChangeCertainty) (BumpWeight) (ChangeRecord)]
  Record Entry
  Remove RecordIdentifier
  ChangeCertainty CertaintyChange
  BumpWeight WeightBump
  ChangeRecord RecordChange
  CommandSemaRead SemaReadInput
  ReplyToSignal SignalOutput
  CommandEffect NexusEffectCommand
  Continue NexusWork

  NexusWork [(SignalArrived) (SemaWriteCompleted) (SemaReadCompleted) (EffectCompleted)]
  NexusAction [(CommandSemaWrite) (CommandSemaRead) (ReplyToSignal) (CommandEffect) (Continue)]

  NexusEffectCommand [(Stash) (ClassifyState) (Propose) (Clarify) (Supersede) (Retire) (OpenIntentSubscription) (CollectRemovalCandidates) (OpenObserverTap) (CloseObserverTap)]
  Stash StashRequest
  ClassifyState Statement
  Propose Entry
  Clarify Clarification
  Supersede Supersession
  Retire Retirement
  OpenIntentSubscription Query
  CollectRemovalCandidates RemovalCandidateCollection
  OpenObserverTap ObserverFilter
  CloseObserverTap SubscriptionToken
  NexusEffectResult [(Stashed) (StateClassified) (Proposed) (Clarified) (Superseded) (Retired) (GuardianRejected) (OperationFailed) (IntentSubscriptionOpened) (RemovalCandidatesCollected) (ObserverTapOpened) (ObserverTapClosed)]
  Stashed StashResult
  StateClassified Entry
  Proposed SemaReceipt
  Clarified ClarificationReceipt
  Superseded SupersessionReceipt
  Retired RetirementReceipt
  GuardianRejected GuardianRejection
  OperationFailed ErrorReport
  IntentSubscriptionOpened IntentSubscription
  RemovalCandidatesCollected RemovalCandidatesCollection
  ObserverTapOpened ObserverSubscription
  ObserverTapClosed ObserverRetraction
  StashRequest { Records * DatabaseMarker * }
  StashResult { StashHandle * RecordCount * DatabaseMarker * }
  GuardianVerdict [Accept (Reject)]
  Reject { GuardianRejectionReason * Explanation * }
}
