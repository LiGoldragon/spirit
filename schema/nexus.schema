{
  SignalInput signal-spirit:signal:Input
  SignalOutput signal-spirit:signal:Output
  SemaReadInput spirit:sema:ReadInput
  SemaReadOutput spirit:sema:ReadOutput
  SemaWriteOutput spirit:sema:WriteOutput
  Records signal-spirit:signal:Records
  RecordCount signal-spirit:signal:RecordCount
  StashHandle signal-spirit:signal:StashHandle
  DatabaseMarker signal-spirit:signal:DatabaseMarker
  Statement signal-spirit:signal:Statement
  RecordRequest signal-spirit:signal:RecordRequest
  Proposal signal-spirit:signal:Proposal
  Entry signal-spirit:signal:Entry
  Clarification signal-spirit:signal:Clarification
  Supersession signal-spirit:signal:Supersession
  Retirement signal-spirit:signal:Retirement
  SemaReceipt signal-spirit:signal:SemaReceipt
  ClarificationReceipt signal-spirit:signal:ClarificationReceipt
  SupersessionReceipt signal-spirit:signal:SupersessionReceipt
  RetirementReceipt signal-spirit:signal:RetirementReceipt
  RemoveReceipt signal-spirit:signal:RemoveReceipt
  RecordChangeReceipt signal-spirit:signal:RecordChangeReceipt
  GuardianRejection signal-spirit:signal:GuardianRejection
  GuardianRejectionReason signal-spirit:signal:GuardianRejectionReason
  ReferentGuardianRejection signal-spirit:signal:ReferentGuardianRejection
  ReferentGuardianRejectionReason signal-spirit:signal:ReferentGuardianRejectionReason
  Explanation signal-spirit:signal:Explanation
  ErrorReport signal-spirit:signal:ErrorReport
  Query signal-spirit:signal:Query
  SubscriptionToken signal-spirit:signal:SubscriptionToken
  IntentSubscription signal-spirit:signal:IntentSubscription
  RecordIdentifier signal-spirit:signal:RecordIdentifier
  Removal signal-spirit:signal:Removal
  CertaintyChange signal-spirit:signal:CertaintyChange
  ImportanceBump signal-spirit:signal:ImportanceBump
  RecordChange signal-spirit:signal:RecordChange
  ReferentRegistration signal-spirit:signal:ReferentRegistration
  ReferentRegistrationReceipt signal-spirit:signal:ReferentRegistrationReceipt
  RemovalCandidateCollection signal-spirit:signal:RemovalCandidateCollection
  RemovalCandidatesCollection signal-spirit:signal:RemovalCandidatesCollection
  ObserverFilter signal-spirit:signal:ObserverFilter
  ObserverSubscription signal-spirit:signal:ObserverSubscription
  ObserverRetraction signal-spirit:signal:ObserverRetraction
}
[SignalArrived SemaWriteCompleted SemaReadCompleted EffectCompleted]
[CommandSemaWrite CommandSemaRead ReplyToSignal CommandEffect Continue]
{
  SignalArrived SignalInput
  SemaWriteCompleted SemaWriteOutput
  SemaReadCompleted SemaReadOutput
  EffectCompleted NexusEffectResult

  CommandSemaWrite [(Record) (Remove) (ChangeCertainty) (BumpImportance) (ChangeRecord) (RegisterReferent)]
  Record Entry
  Remove Removal
  ChangeCertainty CertaintyChange
  BumpImportance ImportanceBump
  ChangeRecord RecordChange
  RegisterReferent ReferentRegistration
  CommandSemaRead SemaReadInput
  ReplyToSignal SignalOutput
  CommandEffect NexusEffectCommand
  Continue NexusWork

  NexusWork [(SignalArrived) (SemaWriteCompleted) (SemaReadCompleted) (EffectCompleted)]
  NexusAction [(CommandSemaWrite) (CommandSemaRead) (ReplyToSignal) (CommandEffect) (Continue)]

  NexusEffectCommand [(Stash) (ClassifyState) (RecordWithImpliedReferents) (GuardRecord) (ProposeWithImpliedReferents) (Propose) (Clarify) (SupersedeWithImpliedReferents) (Supersede) (Retire) (GuardRemove) (ChangeRecordWithImpliedReferents) (GuardChangeRecord) (GuardReferentRegistration) (OpenIntentSubscription) (CollectRemovalCandidates) (OpenObserverTap) (CloseObserverTap)]
  Stash StashRequest
  ClassifyState Statement
  RecordWithImpliedReferents RecordRequest
  GuardRecord RecordRequest
  ProposeWithImpliedReferents Proposal
  Propose Proposal
  Clarify Clarification
  SupersedeWithImpliedReferents Supersession
  Supersede Supersession
  Retire Retirement
  GuardRemove Removal
  ChangeRecordWithImpliedReferents RecordChange
  GuardChangeRecord RecordChange
  GuardReferentRegistration ReferentRegistration
  OpenIntentSubscription Query
  CollectRemovalCandidates RemovalCandidateCollection
  OpenObserverTap ObserverFilter
  CloseObserverTap SubscriptionToken
  NexusEffectResult [(Stashed) (StateClassified) (RecordReferentsSettled) (ProposeReferentsSettled) (SupersedeReferentsSettled) (ChangeRecordReferentsSettled) (Recorded) (Proposed) (Clarified) (Superseded) (Retired) (Removed) (RecordChanged) (GuardianRejected) (ReferentRegistered) (ReferentGuardianRejected) (OperationFailed) (IntentSubscriptionOpened) (RemovalCandidatesCollected) (ObserverTapOpened) (ObserverTapClosed)]
  Stashed StashResult
  StateClassified RecordRequest
  RecordReferentsSettled RecordRequest
  ProposeReferentsSettled Proposal
  SupersedeReferentsSettled Supersession
  ChangeRecordReferentsSettled RecordChange
  Recorded SemaReceipt
  Proposed SemaReceipt
  Clarified ClarificationReceipt
  Superseded SupersessionReceipt
  Retired RetirementReceipt
  Removed RemoveReceipt
  RecordChanged RecordChangeReceipt
  GuardianRejected GuardianRejection
  ReferentRegistered ReferentRegistrationReceipt
  ReferentGuardianRejected ReferentGuardianRejection
  OperationFailed ErrorReport
  IntentSubscriptionOpened IntentSubscription
  RemovalCandidatesCollected RemovalCandidatesCollection
  ObserverTapOpened ObserverSubscription
  ObserverTapClosed ObserverRetraction
  StashRequest { Records * DatabaseMarker * }
  StashResult { StashHandle * RecordCount * DatabaseMarker * }
  GuardianVerdict [Accept (Reject)]
  Reject { GuardianRejectionReason * Explanation * }
  ReferentGuardianVerdict [Accept (RejectReferent)]
  RejectReferent { ReferentGuardianRejectionReason * Explanation * }
}
